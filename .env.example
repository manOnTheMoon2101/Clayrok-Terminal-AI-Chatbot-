XAI_API_KEY=your-xai-api-key-here
GROK_MODEL=grok-3

# Optional: enables the credit balance display in the status line.
# Requires a Management API key with Billing Read permission.
# Create one at: console.x.ai → Settings → Management Keys
XAI_MANAGEMENT_KEY=
# Team ID — copy from the console.x.ai URL (/team/<id>/...). Default is "default".
XAI_TEAM_ID=default

# Optional: display currency (default USD). Uses live exchange rates from open.er-api.com.
# Examples: ZAR, EUR, GBP, JPY, CAD, AUD
CLAYROK_CURRENCY=ZAR
